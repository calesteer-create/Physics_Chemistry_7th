# قاعدة البيانات
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# منطقة المعلم (أسرار — لا تُرفع إلى المستودع)
# كلمة مرور المعلم: إلزامية (6 أحرف على الأقل) وتُضبط في بيئة الخادم فقط.
TEACHER_PASSWORD=
# سرّ توقيع جلسات المعلم: إلزامي في كل بيئة،
# 32 حرفاً على الأقل، عشوائي وغير مشتق من كلمة المرور أو رابط قاعدة البيانات.
# عند غيابه تُرفض جلسات المعلم والوصول إلى منطقة المعلم (fail closed).
TEACHER_SESSION_SECRET=
